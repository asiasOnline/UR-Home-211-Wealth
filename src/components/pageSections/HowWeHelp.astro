---
import { Button } from "@/components/ui/button"
import { getBlock } from "@/lib/notion-content"
import { 
    Card, 
    CardHeader, 
    CardTitle, 
    CardContent,
    CardDescription
} from "@/components/ui/card"
import LivingRoom from "@/assets/images/living-room.png"
import FoodDriveGoods from "@/assets/images/canned-boxed-goods.png"
import WomanFrustrated from "@/assets/images/hands-on-face.png"
import GroupCrafting from "@/assets/images/crafting.png"

const helpHeader =              getBlock("3f84fbaf-9f23-8079-8837-d1af694e884b");
const helpParagraph =           getBlock("3f84fbaf-9f23-8004-a3c2-d49d51f62d7a");
const residentCardTitle =       getBlock("3f84fbaf-9f23-808c-91ec-ecfd1b22d529");
const residentCartSubtitle =    getBlock("3f84fbaf-9f23-8077-94e5-efcf7ff8667a")
const residentCardDescription = getBlock("3f84fbaf-9f23-80bd-83d7-edc839a3b8cd");
---

<section class="flex flex-col justify-center items-center">
    <div class="max-w-xl">
        <h2 class="text-3xl font-bold text-center pb-4" set:html={helpHeader.html} />
        <p set:html={helpParagraph.html}/>
    </div>
    <div>
        <Card className="px-2 py-6 w-80">
            <CardHeader>
                <CardTitle className="text-xl" set:html={residentCardTitle.html}/>
            </CardHeader>
            <CardContent className="flex flex-col gap-2">
                <img 
                    src={LivingRoom.src}
                    alt='Four women hugging'
                    class="rounded-2xl w-full h-auto"
                    width={320}
                    height={240}
                />
                <p class="text-bold" set:html={residentCartSubtitle.html}/>
                <CardDescription set:html={residentCardDescription.html} />
            </CardContent>
        </Card>
    </div>
</section>